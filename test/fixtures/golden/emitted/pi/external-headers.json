[
  {
    "path": "/workspace/.coding-runtime/pi/models.json",
    "values": {
      "providers": {
        "langop": {
          "baseUrl": "http://gateway.default.svc.cluster.local:8000/v1",
          "api": "openai-completions",
          "apiKey": "sk-langop-proxy",
          "models": [
            {
              "id": "claude-sonnet-4-5"
            }
          ]
        }
      }
    },
    "owns": [
      "providers"
    ]
  },
  {
    "path": "/workspace/.coding-runtime/pi/settings.json",
    "values": {
      "defaultProvider": "langop",
      "defaultModel": "claude-sonnet-4-5",
      "enableInstallTelemetry": false
    },
    "owns": [
      "defaultProvider",
      "defaultModel",
      "enableInstallTelemetry"
    ]
  },
  {
    "path": "/workspace/.coding-runtime/pi/mcp.json",
    "values": {
      "mcpServers": {
        "control-plane": {
          "url": "https://cloud.example.com/mcp",
