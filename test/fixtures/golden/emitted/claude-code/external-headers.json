[
  {
    "path": "/workspace/.claude/settings.json",
    "values": {
      "preferredNotifChannel": "terminal_bell",
      "model": "claude-sonnet-4-5"
    },
    "owns": [
      "preferredNotifChannel",
      "model"
    ]
  },
  {
    "path": "/workspace/.claude/.claude.json",
    "values": [
      [
        "mcpServers",
        {
          "control-plane": {
            "type": "http",
            "url": "https://cloud.example.com/mcp",
            "headers": {
              "Authorization": "Bearer ${CONTROL_PLANE_TOKEN}",
              "X-Agent": "external"
            }
          },
          "in-cluster": {
            "type": "http",
            "url": "http://tool.default.svc.cluster.local:8080/mcp"
          }
        }
      ],
      [
        [
          "projects",
          "/workspace",
          "hasTrustDialogAccepted"
        ],
        true
      ],
      [
        [
          "projects",
          "/workspace",
          "hasCompletedProjectOnboarding"
        ],
        true
      ]
    ],
    "owns": [
      "mcpServers",
      [
        "projects",
        "/workspace",
        "hasTrustDialogAccepted"
      ],
      [
        "projects",
        "/workspace",
        "hasCompletedProjectOnboarding"
      ]
    ]
  }
]
